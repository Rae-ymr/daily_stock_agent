# Copy this file to .env and fill in your own keys. Never commit the real .env.

# LLM provider — set LLM_PROVIDER to "groq" (default, free tier, get a key at
# console.groq.com/keys) or "openai" (uses gpt-4o-mini). Fill in whichever key
# matches your choice; the other can stay blank. See agent/llm.py.
LLM_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=
# Embeddings always run locally via sentence-transformers — no key needed.

# News source (used in data/ingest_news.py) — get a free key at tavily.com
TAVILY_API_KEY=

# Tickers to track, comma-separated
STOCK_LIST=AAPL,MSFT

# Redis — stores in-progress human-checkpoint sessions between the
# /analyze and /approve API calls (see app/session_store.py). Defaults to
# localhost, which works if you run `redis-server` locally; docker-compose
# overrides this to redis://redis:6379/0 for the containerized service.
REDIS_URL=redis://localhost:6379/0

# Email notifications (used in agent/graph.py log_and_notify_node)
# SMTP_USER is your Gmail address; SMTP_APP_PASSWORD is a Gmail *app password*
# (not your login password) — generate one at myaccount.google.com/apppasswords
SMTP_USER=
SMTP_APP_PASSWORD=
NOTIFY_EMAIL_TO=yumingrui.silverdew@gmail.com
